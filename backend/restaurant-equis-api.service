[Unit]
Description=Restaurant Equis — FastAPI Backend
Documentation=https://github.com/equis/restaurant-equis
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/restaurant-equis/backend

# Carga el archivo .env con las credenciales de BD
EnvironmentFile=/opt/restaurant-equis/backend/.env

# Ruta al Python del virtualenv
ExecStart=/opt/restaurant-equis/backend/venv/bin/uvicorn \
    main:app \
    --host 127.0.0.1 \
    --port 5000 \
    --workers 2 \
    --log-level info

# Reinicio automático si falla
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restaurant-equis-api

# Seguridad: limitar acceso al sistema de archivos
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
