[Unit]
Description=Tradiciones y Sabores — FastAPI Backend
Documentation=https://github.com/teofilobetancourt/Restaurant-Equis
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/tradiciones-sabores/backend
EnvironmentFile=/opt/tradiciones-sabores/backend/.env

ExecStart=/opt/tradiciones-sabores/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000 --workers 1 --log-level info

Restart=always
RestartSec=3s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradiciones-sabores-api

[Install]
WantedBy=multi-user.target
